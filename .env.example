# Copy to .env.local for local development, and set the same three variables in
# the Vercel dashboard under Settings -> Environment Variables for production.
#
# These are read ONLY by the serverless function in api/contact.js. They are not
# prefixed with VITE_, so Vite will never bundle them into the client. Do not
# rename them to VITE_* — that would publish your API key in the browser.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form messages get delivered
CONTACT_TO=kuraisler.dev@gmail.com

# Verified sender. Must be on a domain you've verified in Resend.
# Before your domain is verified you can use: Portfolio <onboarding@resend.dev>
CONTACT_FROM=Portfolio <contact@yourdomain.com>

# Signing secret for the Resend webhook that drives api/inbound.js
# (Resend → Webhooks → your endpoint → copy the whsec_… secret).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Supabase credentials used by api/views.js. Keep the service-role key server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
