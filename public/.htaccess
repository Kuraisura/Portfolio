Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Use one canonical hostname after SSL is enabled for both hostnames.
  RewriteCond %{HTTP_HOST} ^www\.kuraisler\.xyz$ [NC]
  RewriteRule ^ https://kuraisler.xyz%{REQUEST_URI} [R=301,L]

  # Vite SPA fallback while preserving real files such as robots.txt and sitemap.xml.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
